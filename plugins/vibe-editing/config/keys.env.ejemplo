# Claves de API — cada persona pone las suyas. Copiá este archivo como keys.env:
#   cp plugins/vibe-editing/config/keys.env.ejemplo plugins/vibe-editing/config/keys.env
# keys.env está ignorado por git: nunca se sube al repositorio.

# Groq: transcripción rápida y gratuita. Sacá la tuya en https://console.groq.com
# (registrarse > API Keys > Create API Key). Sin esta clave, el kit transcribe
# localmente: funciona igual, pero mucho más lento.
GROQ_API_KEY=

# Opcional: subtítulos con el mejor criterio de estilo. Sin esto usa tu sesión de Claude Code.
ANTHROPIC_API_KEY=

# Opcional: limpieza de audio y efectos.
ELEVENLABS_API_KEY=
